# Copy to .env and fill in. Never commit .env.

# OpenRouter key (free account): https://openrouter.ai/keys
OPENROUTER_API_KEY= 
MODEL=nvidia/nemotron-3.5-super-vl:free
# video = send a short mp4 clip around the motion; frames = send a 2x2 sheet of 4 frames
AI_INPUT=video
# OpenRouter gives 50 free calls a day without credits; stop at 45 to keep 5 spare
DAILY_CAP=45
ALERT_MIN_CONFIDENCE=0.5

# Camera: a video file, a webcam index (0) or a stream URL like rtsp://user:pass@192.168.1.20:554/stream1
SOURCE=0
APP_NAME=Nazar
# What to watch for: home, shop, parking, exam, traffic, pets, site (see README)
PROFILE=home
# Leave empty for the profile's default camera name (Living Room, Aisle 3, Gate Camera, ...)
CAMERA_NAME=

# Motion check (runs on your laptop, free). Trigger = % of the picture that changed in the last second.
MOTION_TRIGGER=0.8
PRE_ROLL=2
POST_ROLL=4
CLIP_FPS=6
MAX_PER_ARM=6

# Where alerts go: telegram, hermes, or both (telegram,hermes)
ALERTS=telegram
# photo = the 4-frame sheet, video = the clip
ALERT_MEDIA=photo

# Telegram: create a bot with @BotFather (/newbot), paste the token, then run: python3 app.py telegram
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Hermes Agent webhook (filled in by: python3 app.py hermes)
HERMES_WEBHOOK_URL=http://localhost:8644/webhooks/nazar
HERMES_WEBHOOK_SECRET=
